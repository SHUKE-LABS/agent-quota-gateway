[Unit]
Description=agent-quota-gateway (Anthropic pool proxy)
Documentation=https://github.com/shukebeta/agent-quota-gateway
# Shared mode binds a Tailscale address, so wait for the network and the
# tailscaled interface. If the IP is not assigned yet at boot the bind
# fails and Restart=always retries until tailscaled brings it up.
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=simple
ExecStart=/usr/local/bin/agent-quota-gateway
# Config file (issue #198): the mutable single source of truth for pools,
# members, credentials, priority, balance, and disabled. It lives under the
# StateDirectory so the DynamicUser can rewrite it when operators change pools
# through the UI/API. %S expands to /var/lib. The file is created 0600 by the
# service on first start and never overwritten by a redeploy.
Environment=AQG_CONFIG=%S/agent-quota-gateway/aqg.json
# On every start the gateway also reconciles any still-unmigrated legacy
# state-file priority_override into aqg.json (issue #241), so an
# operator-adjusted pool order from a pre-#198 install survives a redeploy.
# Once migrated, aqg.json is the sole source of truth and the state file's
# overlay keys become inert.
# Bootstrap seed only. On the FIRST start (no aqg.json yet) the gateway reads
# these AQG_POOL_* vars + any existing state file to generate aqg.json, then
# never consults the environment again. Safe to leave in place (ignored once
# aqg.json exists) or remove after the first successful start. Read by the
# systemd manager (root) and injected into the process environment, so it
# stays 0600 root:root.
EnvironmentFile=-/etc/agent-quota-gateway/aqg.env
Restart=always
RestartSec=2
# The app drains in-flight streaming responses for up to 30s on shutdown;
# give it a hair more before SIGKILL.
TimeoutStopSec=35

# --- Hardening -----------------------------------------------------------
# An ephemeral, unprivileged service account created per start. No manual
# useradd, no home, nothing on disk to own.
DynamicUser=yes
# StateDirectory gives the dynamic user a writable /var/lib/agent-quota-gateway/
# and sets $STATE_DIRECTORY in the process environment; the binary uses
# $STATE_DIRECTORY/state.json for write-through persistence by default.
StateDirectory=agent-quota-gateway
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Only IP sockets are needed (outbound HTTPS to upstreams + the listener).
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
